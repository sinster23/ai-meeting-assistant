{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",

    "lib": ["ES2020"],

    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "baseUrl": ".",

    "paths": {
      "@repo/types": ["../../packages/types"]
    }
  },

  "include": [
    "src",
    "../../packages/types"
  ],

  "exclude": ["node_modules", "dist"]
}